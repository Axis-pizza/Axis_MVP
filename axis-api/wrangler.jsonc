{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "axis-api",
	"main": "src/app.ts",
	"compatibility_date": "2025-12-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "axis_db_core",
			"database_name": "axis-db-core",
			"database_id": "8e147ffb-344a-402e-bf70-18b21a076bfe",
			"migrations_dir": "./migrations"
		},
		{
			"binding": "axis_db_analytics",
			"database_name": "axis-db-analytics",
			"database_id": "74937424-daf6-45a2-9965-bd929264f442"
		},
		{
			// VIPリスト管理用DB
			"binding": "whitelist_db",
			"database_name": "axis-wlv2",
			"database_id": "ae62cf10-e8b1-4cfb-8823-91da78d51220",
			"migrations_dir": "./migrations"
		}
	],
	// AIバインディングも必要なら追加
	"ai": {
		"binding": "AI"
	},
	// Vectorizeも必要なら追加 (以前のtomlにあったもの)
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "axis-vector-index"
		},
		{
			"binding": "VECTORIZE",
			"index_name": "axis-vector-index"
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "axis-images",
			"preview_bucket_name": "axis-images-preview"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"0 * * * *"
		]
	}
}